{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Audio Cutter & Joiner",
  "nameJa": "音声カット・結合",
  "slug": "audio-cutter-joiner",
  "version": "1.0.1",
  "description": "Trim, split, reorder, preview, and export multiple audio clips locally as MP3, M4A/AAC, or WAV.",
  "descriptionJa": "音声をカット・分割・並べ替えし、完成順に試聴してMP3・M4A/AAC・WAVとして書き出せます。ファイルは外部へ送信しません。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-audio-cutter-joiner"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
